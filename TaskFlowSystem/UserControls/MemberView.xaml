<UserControl x:Class="TaskFlowSystem.UserControls.MemberView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100"
             Background="#0B120F">

    <UserControl.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#101A15"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3DDC97"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E5F0E9"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#82968A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#24372C"/>

        <Style x:Key="ProfileButton" TargetType="Button">
            <Setter Property="Background" Value="#1B3024"/>
            <Setter Property="Foreground" Value="#3DDC97"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#264B36"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Background" Value="#3DDC97"/>
            <Setter Property="Foreground" Value="#0B120F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#55E9AA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#111D16"/>
            <Setter Property="Foreground" Value="#E5F0E9"/>
            <Setter Property="CaretBrush" Value="#3DDC97"/>
            <Setter Property="BorderBrush" Value="#294334"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Участники"
                           Foreground="#E5F0E9"
                           FontSize="25"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Управление участниками вашей команды"
                           Foreground="#82968A"
                           FontSize="12"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="+  Добавить участника"
                    Style="{StaticResource AddButton}"
                    VerticalAlignment="Center"
                    Click="AddNewMember_Click"/>
        </Grid>

        <!-- Статистика -->
        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#101A15"
                    BorderBrush="#24372C"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,8,0">

                <StackPanel>
                    <TextBlock Text="Всего участников"
                               Foreground="#82968A"
                               FontSize="11"/>

                    <TextBlock Text="0"
                               Foreground="#E5F0E9"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#101A15"
                    BorderBrush="#24372C"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="4,0">

                <StackPanel>
                    <TextBlock Text="В сети"
                               Foreground="#82968A"
                               FontSize="11"/>

                    <TextBlock Text="0"
                               Foreground="#3DDC97"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#101A15"
                    BorderBrush="#24372C"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="8,0,0,0">

                <StackPanel>
                    <TextBlock Text="Администраторы"
                               Foreground="#82968A"
                               FontSize="11"/>

                    <TextBlock Text="0"
                               Foreground="#E5F0E9"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Поиск и фильтры -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource SearchBox}"
                     Height="38"
                     Text="Поиск по имени или должности..."
                     Margin="0,0,12,0"/>

            <Button Grid.Column="1"
                    Content="Все участники  ▾"
                    Background="#17251D"
                    Foreground="#B9C9BF"
                    BorderBrush="#294334"
                    BorderThickness="1"
                    Padding="14,8"
                    FontSize="11"
                    Cursor="Hand"/>
        </Grid>

        <!-- Список пользователей -->
        <Border Grid.Row="3"
                Background="#101A15"
                BorderBrush="#24372C"
                BorderThickness="1"
                CornerRadius="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовки колонок -->
                <Border Grid.Row="0"
                        BorderBrush="#24372C"
                        BorderThickness="0,0,0,1"
                        Padding="18,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="ПОЛЬЗОВАТЕЛЬ"
                                   Foreground="#607568"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="РОЛЬ"
                                   Foreground="#607568"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="СТАТУС"
                                   Foreground="#607568"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="3"
                                   Text="ДЕЙСТВИЯ"
                                   Foreground="#607568"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- Участник 1 -->
                        <Border Padding="18,15"
                                BorderBrush="#1C2B22"
                                BorderThickness="0,0,0,1">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <Border Width="38"
                                            Height="38"
                                            Background="#24583F"
                                            CornerRadius="19">
                                        <TextBlock Text="АД"
                                                   Foreground="#3DDC97"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center"
                                                Margin="12,0,0,0">

                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                            <TextBlock Text="everidiy"
                                                       Foreground="#E5F0E9"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>

                                            <Border Background="#1B3829"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Margin="8,0,0,0">

                                                <TextBlock Text="Вы"
                                                           Foreground="#3DDC97"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                        </StackPanel>

                                        <TextBlock Text="everidiy@example.com"
                                                   Foreground="#82968A"
                                                   FontSize="10"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="Разработчик"
                                           Foreground="#B9C9BF"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="#3DDC97"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text=" В сети"
                                               Foreground="#3DDC97"
                                               FontSize="10"
                                               Margin="5,0,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Content="Профиль"
                                        Style="{StaticResource ProfileButton}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</UserControl>
