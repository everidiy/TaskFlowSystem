<UserControl x:Class="TaskFlowSystem.UserControls.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#142019"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#263A2D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#829188"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3DDC97"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SmallText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,28,34,30">

            <!-- Заголовок -->
            <TextBlock Text="Отчёты"
                       Foreground="White"
                       FontSize="27"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Анализируйте продуктивность и отслеживайте результаты команды"
                       Foreground="#829188"
                       FontSize="13"
                       Margin="0,7,0,25"/>

            <!-- Период -->
            <DockPanel Margin="0,0,0,20">
                <TextBlock Text="Общая статистика"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <ComboBox DockPanel.Dock="Right"
                          Width="150"
                          Height="34"
                          SelectedIndex="0"
                          Background="#19251D"
                          Foreground="White"
                          BorderBrush="#304536">
                    <ComboBoxItem Content="За неделю"/>
                    <ComboBoxItem Content="За месяц"/>
                    <ComboBoxItem Content="За год"/>
                    <ComboBoxItem Content="За всё время"/>
                </ComboBox>
            </DockPanel>

            <!-- Карточки статистики -->
            <UniformGrid Columns="4" Margin="0,0,0,22">

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Всего задач" Style="{StaticResource SmallText}"/>
                        <TextBlock Text="128" Foreground="White"
                                   FontSize="29" FontWeight="SemiBold"
                                   Margin="0,10,0,5"/>
                        <TextBlock Text="+12 за неделю" Foreground="#3DDC97"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Выполнено" Style="{StaticResource SmallText}"/>
                        <TextBlock Text="86" Foreground="White"
                                   FontSize="29" FontWeight="SemiBold"
                                   Margin="0,10,0,5"/>
                        <TextBlock Text="67% от общего числа"
                                   Foreground="#3DDC97" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="В работе" Style="{StaticResource SmallText}"/>
                        <TextBlock Text="24" Foreground="White"
                                   FontSize="29" FontWeight="SemiBold"
                                   Margin="0,10,0,5"/>
                        <TextBlock Text="18% от общего числа"
                                   Foreground="#E6B85C" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Просрочено" Style="{StaticResource SmallText}"/>
                        <TextBlock Text="8" Foreground="White"
                                   FontSize="29" FontWeight="SemiBold"
                                   Margin="0,10,0,5"/>
                        <TextBlock Text="Требуют внимания"
                                   Foreground="#EF7777" FontSize="12"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Графики -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Активность команды"
                                   Foreground="White" FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Количество выполненных задач за неделю"
                                   Style="{StaticResource SmallText}"
                                   Margin="0,6,0,20"/>

                        <!-- Условный график -->
                        <UniformGrid Rows="1" Height="150"
                                     VerticalAlignment="Bottom">
                            <StackPanel VerticalAlignment="Bottom" Margin="5">
                                <Border Height="65" Background="#3DDC97"
                                        CornerRadius="5,5,0,0"/>
                                <TextBlock Text="Пн" Foreground="#829188"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Margin="5">
                                <Border Height="95" Background="#3DDC97"
                                        CornerRadius="5,5,0,0"/>
                                <TextBlock Text="Вт" Foreground="#829188"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Margin="5">
                                <Border Height="75" Background="#3DDC97"
                                        CornerRadius="5,5,0,0"/>
                                <TextBlock Text="Ср" Foreground="#829188"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Margin="5">
                                <Border Height="120" Background="#3DDC97"
                                        CornerRadius="5,5,0,0"/>
                                <TextBlock Text="Чт" Foreground="#829188"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Margin="5">
                                <Border Height="90" Background="#3DDC97"
                                        CornerRadius="5,5,0,0"/>
                                <TextBlock Text="Пт" Foreground="#829188"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Margin="5">
                                <Border Height="45" Background="#3DDC97"
                                        CornerRadius="5,5,0,0"/>
                                <TextBlock Text="Сб" Foreground="#829188"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Margin="5">
                                <Border Height="60" Background="#3DDC97"
                                        CornerRadius="5,5,0,0"/>
                                <TextBlock Text="Вс" Foreground="#829188"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Статусы задач"
                                   Foreground="White" FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Распределение по этапам"
                                   Style="{StaticResource SmallText}"
                                   Margin="0,6,0,22"/>

                        <TextBlock Text="К выполнению — 10"
                                   Foreground="White" FontSize="13"/>
                        <ProgressBar Value="8" Maximum="100" Height="7"
                                     Background="#29382E" Foreground="#829188"
                                     Margin="0,8,0,17"/>

                        <TextBlock Text="В работе — 24"
                                   Foreground="White" FontSize="13"/>
                        <ProgressBar Value="19" Maximum="100" Height="7"
                                     Background="#29382E" Foreground="#E6B85C"
                                     Margin="0,8,0,17"/>

                        <TextBlock Text="Review — 8"
                                   Foreground="White" FontSize="13"/>
                        <ProgressBar Value="6" Maximum="100" Height="7"
                                     Background="#29382E" Foreground="#7D9CF5"
                                     Margin="0,8,0,17"/>

                        <TextBlock Text="Выполнено — 86"
                                   Foreground="White" FontSize="13"/>
                        <ProgressBar Value="67" Maximum="100" Height="7"
                                     Background="#29382E" Foreground="#3DDC97"
                                     Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Нижняя информация -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Эффективность проекта"
                               Foreground="White" FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Общий процент завершённых задач"
                               Style="{StaticResource SmallText}"
                               Margin="0,6,0,15"/>

                    <DockPanel>
                        <TextBlock Text="67%"
                                   Foreground="#3DDC97"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Right"/>
                        <ProgressBar Value="67" Maximum="100"
                                     Height="10"
                                     VerticalAlignment="Center"
                                     Background="#29382E"
                                     Foreground="#3DDC97"/>
                    </DockPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
