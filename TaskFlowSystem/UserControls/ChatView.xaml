<UserControl x:Class="TaskFlowSystem.UserControls.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3DDC97"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E5F0E9"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#82968A"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A9BCAF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C3025"/>
                    <Setter Property="Foreground" Value="#3DDC97"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChatItemButton" TargetType="Button">
            <Setter Property="Background" Value="#111F17"/>
            <Setter Property="Foreground" Value="#E5F0E9"/>
            <Setter Property="BorderBrush" Value="#23392C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChatItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChatItemBorder" Property="Background" Value="#172C21"/>
                                <Setter TargetName="ChatItemBorder" Property="BorderBrush" Value="#3B624C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChatItemBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список пользователей -->
                <Border Grid.Column="0"
                 Background="#0D1712"
                 BorderBrush="#1D3025"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,0,18,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Grid Margin="24,24,24,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Сообщения"
                                   Foreground="#E5F0E9"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Ваши диалоги"
                                   Foreground="#82968A"
                                   FontSize="14"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="+"
                            Style="{StaticResource ActionButton}"
                            Width="42"
                            Height="42"/>
                </Grid>

                <!-- Поиск -->
                 <TextBox Grid.Row="1"
                         Margin="20,0,20,18"
                         Height="46"
                          Background="#0F1B14"
                         Foreground="#82968A"
                          BorderBrush="#20382A"
                         BorderThickness="1"
                         Padding="14,10"
                         FontSize="14"
                         Text="Поиск пользователей..."/>

                <!-- Чат  -->
                     <StackPanel Grid.Row="2" Margin="14,0">

                      <Button x:Name="FavoritesChatButton"
                            Style="{StaticResource ChatItemButton}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                             <Border Width="54"
                                    Height="52"
                                    CornerRadius="13"
                                     Background="#102219"
                                    VerticalAlignment="Center">

                                 <Border CornerRadius="11">
                                    <Image Source="/Resources/bookmark.png"
                                           Stretch="UniformToFill"
                                             Width="30"
                                             Height="30"/>
                                </Border>
                            </Border>

                             <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                         Margin="18,0,0,0">

                                <TextBlock Text="Избранное"
                                           Foreground="#E5F0E9"
                                           FontWeight="SemiBold"
                                             FontSize="15"/>
                                 <TextBlock Text="Личные заметки и важные задачи"
                                            Foreground="#82968A"
                                            FontSize="11"
                                            Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                     </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Стартовое состояние чатов -->
        <Border Grid.Column="1"
                Background="#101A15"
                BorderBrush="#24372C"
                BorderThickness="1"
                CornerRadius="12">

            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Иконка -->
                    <Border Width="76"
                            Height="76"
                            Background="#17291F"
                            CornerRadius="22"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,22">

                        <TextBlock Text="✉"
                                   FontSize="34"
                                   Foreground="#3DDC97"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Ваши сообщения"
                               Foreground="#E5F0E9"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Выберите пользователя, чтобы начать общение"
                               Foreground="#82968A"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,9,0,0"/>

                    <Border Width="45"
                            Height="3"
                            Background="#3DDC97"
                            CornerRadius="2"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
