<UserControl x:Class="TaskFlowSystem.UserControls.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="1200">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#142019"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#263A2D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#829188"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#829188"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>

        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EAF6EF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="24" Height="24">
                            <Border x:Name="CheckBoxBorder"
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#111D16"
                                    BorderBrush="#42604D"
                                    BorderThickness="1.5"
                                    CornerRadius="7">
                                <Path x:Name="CheckMark"
                                      Width="11"
                                      Height="8"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="#06251A"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 1,4 L 4,7 L 10,1"
                                      Visibility="Collapsed"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#3DDC97"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#3DDC97"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#6BE9B4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAF6EF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E3A2D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#214A38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EAF6EF"/>
            <Setter Property="Background" Value="#17241D"/>
            <Setter Property="BorderBrush" Value="#3B5A48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                  Focusable="False"
                                  ClickMode="Press"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10"
                                        Padding="15,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center"
                                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                          TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1"
                                              Width="9"
                                              Height="5"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Fill="#8FA99A"
                                              Data="M 0 0 L 9 0 L 4.5 5 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#1E3A2D"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#4C8064"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#3DDC97"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="DropDown"
                           AllowsTransparency="True"
                           Focusable="False"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=DropDownToggle}"
                           PopupAnimation="Slide">
                                <Border Width="{Binding ActualWidth, ElementName=DropDownToggle}"
                                Margin="0,5,0,0"
                                Background="#17241D"
                                BorderBrush="#3B5A48"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="4">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDown" Property="MinHeight" Value="30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="42,34,42,38">

            <TextBlock Text="Настройки"
                       Foreground="White" FontSize="34"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Управляйте своим аккаунтом и рабочим пространством"
                        Foreground="#829188" FontSize="15"
                        Margin="0,9,0,32"/>

            <!-- Профиль -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Профиль" Style="{StaticResource SettingTitle}"/>
                    <TextBlock Text="Основная информация вашего аккаунта"
                               Style="{StaticResource Description}"
                               Margin="0,5,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="92" Height="92"
                                Background="#243B2D"
                                CornerRadius="36"
                                VerticalAlignment="Top">
                            <TextBlock Text="BD"
                                       Foreground="#3DDC97"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Имя пользователя"
                                       Foreground="#829188" FontSize="12"/>
                            <TextBox Text="Богдан Давыдов"
                                      Height="46"
                                      Margin="0,8,0,18"
                                     Background="#1B2920"
                                     Foreground="White"
                                     BorderBrush="#304536"
                                      Padding="14,10"
                                      FontSize="14"/>

                            <TextBlock Text="Электронная почта"
                                       Foreground="#829188" FontSize="12"/>
                            <TextBox Text="example@mail.com"
                                      Height="46"
                                      Margin="0,8,0,0"
                                     Background="#1B2920"
                                     Foreground="White"
                                     BorderBrush="#304536"
                                      Padding="14,10"
                                      FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Сохранить изменения"
                            HorizontalAlignment="Right"
                            Background="#3DDC97"
                            Foreground="#0D1711"
                            FontWeight="SemiBold"
                            Padding="18,9"
                            Margin="0,18,0,0"
                            BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Уведомления -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Уведомления" Style="{StaticResource SettingTitle}"/>
                    <TextBlock Text="Выберите, какие события будут отправлять уведомления"
                               Style="{StaticResource Description}"
                               Margin="0,5,0,18"/>

                    <DockPanel Margin="0,0,0,17">
                        <CheckBox x:Name="MentionsNotificationsCheckBox"
                                  IsChecked="True"
                                  Style="{StaticResource SettingsCheckBox}"
                                  DockPanel.Dock="Right"
                                  VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Упоминания"
                                       Foreground="White" FontSize="15"/>
                            <TextBlock Text="Когда участники упоминают вас в задачах или чате"
                                       Style="{StaticResource Description}"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,17">
                        <CheckBox x:Name="TaskChangesNotificationsCheckBox"
                                  IsChecked="True"
                                  Style="{StaticResource SettingsCheckBox}"
                                  DockPanel.Dock="Right"
                                  VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Изменения задач"
                                        Foreground="White" FontSize="15"/>
                            <TextBlock Text="Изменение статуса, исполнителя и сроков"
                                       Style="{StaticResource Description}"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <CheckBox x:Name="WeeklyReportNotificationsCheckBox"
                                  IsChecked="False"
                                  Style="{StaticResource SettingsCheckBox}"
                                  DockPanel.Dock="Right"
                                  VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Еженедельный отчёт"
                                        Foreground="White" FontSize="15"/>
                            <TextBlock Text="Сводка активности за прошедшую неделю"
                                       Style="{StaticResource Description}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Внешний вид -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Внешний вид" Style="{StaticResource SettingTitle}"/>
                    <TextBlock Text="Настройте интерфейс приложения"
                               Style="{StaticResource Description}"
                               Margin="0,5,0,18"/>

                    <DockPanel Margin="0,0,0,15">
                        <ComboBox Width="190" Height="44"
                                  SelectedIndex="0"
                                  Style="{StaticResource ComboBox}"
                                  DockPanel.Dock="Right"
                                  Background="#1B2920"
                                  Foreground="White"
                                   BorderBrush="#304536"
                                   FontSize="14">
                            <ComboBoxItem Content="Тёмная"/>
                            <ComboBoxItem Content="Светлая"/>
                            <ComboBoxItem Content="Системная"/>
                        </ComboBox>
                        <StackPanel>
                            <TextBlock Text="Тема оформления"
                                       Foreground="White" FontSize="13"/>
                            <TextBlock Text="Выберите цветовую тему приложения"
                                       Style="{StaticResource Description}"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <ComboBox Width="150" Height="33"
                                  SelectedIndex="0"
                                  DockPanel.Dock="Right"
                                  Background="#1B2920"
                                  Foreground="White"
                                  BorderBrush="#304536"
                                  Style="{StaticResource ComboBox}">
                            <ComboBoxItem Content="Русский"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                        <StackPanel>
                            <TextBlock Text="Язык интерфейса"
                                       Foreground="White" FontSize="13"/>
                            <TextBlock Text="Язык отображения элементов"
                                       Style="{StaticResource Description}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Рабочее пространство -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Рабочее пространство"
                               Style="{StaticResource SettingTitle}"/>
                    <TextBlock Text="Управление параметрами проекта и команды"
                               Style="{StaticResource Description}"
                               Margin="0,5,0,18"/>

                    <DockPanel Margin="0,0,0,15">
                        <TextBlock Text="TaskFlow Team"
                                   Foreground="White"
                                   FontSize="13"
                                   DockPanel.Dock="Right"/>
                        <TextBlock Text="Название пространства"
                                   Foreground="#829188"
                                   FontSize="13"/>
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Text="0 участников"
                                   Foreground="White"
                                   FontSize="13"
                                   DockPanel.Dock="Right"/>
                        <TextBlock Text="Участники команды"
                                   Foreground="#829188"
                                   FontSize="13"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Опасная зона -->
            <Border Background="#251817"
                    BorderBrush="#57302B"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Опасная зона"
                               Foreground="#EF7777"
                               FontSize="15"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Удаление аккаунта приведёт к потере доступа к рабочему пространству."
                               Foreground="#B58A86"
                               FontSize="12"
                               Margin="0,7,0,15"/>

                    <Button Content="Удалить аккаунт"
                            HorizontalAlignment="Left"
                            Background="#813B36"
                            Foreground="White"
                            Padding="16,8"
                            BorderThickness="0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
