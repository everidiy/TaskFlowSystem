<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== Палитра ==================== -->
    <SolidColorBrush x:Key="TfTextBrush" Color="#EAF6EF"/>
    <SolidColorBrush x:Key="TfMutedBrush" Color="#7E9186"/>
    <SolidColorBrush x:Key="TfFaintBrush" Color="#4E6157"/>
    <SolidColorBrush x:Key="TfBorderBrush" Color="#22332B"/>
    <SolidColorBrush x:Key="TfInputBackground" Color="#121C16"/>
    <SolidColorBrush x:Key="TfAccentBrush" Color="#3DDC97"/>

    <!-- ==================== Градиенты ==================== -->
    <LinearGradientBrush x:Key="TfWindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D1712" Offset="0"/>
        <GradientStop Color="#0A100D" Offset="0.55"/>
        <GradientStop Color="#0C1410" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TfCardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#131E17" Offset="0"/>
        <GradientStop Color="#0F1712" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TfPrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4BE3A5" Offset="0"/>
        <GradientStop Color="#17C29A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TfPrimaryHoverGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#63EDB4" Offset="0"/>
        <GradientStop Color="#25D2A8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TfAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3DDC97" Offset="0"/>
        <GradientStop Color="#0FA583" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TfActiveCardGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E3A2D" Offset="0"/>
        <GradientStop Color="#162B22" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TfTitleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EAF6EF" Offset="0"/>
        <GradientStop Color="#9FE8C6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TfLineGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#003DDC97" Offset="0"/>
        <GradientStop Color="#663DDC97" Offset="0.5"/>
        <GradientStop Color="#003DDC97" Offset="1"/>
    </LinearGradientBrush>

    <!-- ==================== Основная кнопка ==================== -->
    <Style x:Key="TfPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#06251A"/>
        <Setter Property="Background" Value="{StaticResource TfPrimaryGradient}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource TfPrimaryHoverGradient}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Вторичная кнопка ==================== -->
    <Style x:Key="TfSecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#9FB8AA"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#263A2F"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#17241D"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#33503F"/>
                            <Setter Property="Foreground" Value="#DFF3E8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Кнопка-ссылка ==================== -->
    <Style x:Key="TfLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="#6EE7B7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2,2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="LinkBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#A6F4D3"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#3E4F46"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Кнопки управления окном ==================== -->
    <Style x:Key="TfWindowButton" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#7E9186"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="WinBorder" Background="Transparent" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="WinBorder" Property="Background" Value="#1B2E24"/>
                            <Setter Property="Foreground" Value="#DFF3E8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TfWindowCloseButton" TargetType="Button" BasedOn="{StaticResource TfWindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="WinBorder" Background="Transparent" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="WinBorder" Property="Background" Value="#3A1F26"/>
                            <Setter Property="Foreground" Value="#FF9AA8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Поле ввода ==================== -->
    <Style x:Key="TfInput" TargetType="TextBox">
        <Setter Property="Height" Value="54"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{StaticResource TfInputBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TfTextBrush}"/>
        <Setter Property="CaretBrush" Value="#3DDC97"/>
        <Setter Property="SelectionBrush" Value="#3DDC97"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#24362C"
                            BorderThickness="1"
                            CornerRadius="14">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsKeyboardFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="#2E4A3B"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="#3DDC97"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Подпись поля ==================== -->
    <Style x:Key="TfFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#6E8478"/>
        <Setter Property="Margin" Value="4,0,0,8"/>
    </Style>

    <!-- ==================== Карточка профиля (кнопка) ==================== -->
    <Style x:Key="TfProfileCard" TargetType="Button">
        <Setter Property="Height" Value="68"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="#111C16"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#22332B"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="Background" Value="#16241D"/>
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2E4A3B"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CardBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter TargetName="CardBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Выбор цвета-акцента ==================== -->
    <Style x:Key="TfAccentSwatch" TargetType="RadioButton">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Width="38" Height="38">
                        <Border x:Name="SwatchRing"
                                CornerRadius="19"
                                BorderBrush="Transparent"
                                BorderThickness="2"/>
                        <Border x:Name="SwatchDot"
                                Width="26" Height="26"
                                CornerRadius="13"
                                Background="{TemplateBinding Background}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwatchRing" Property="BorderBrush" Value="#3A5445"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwatchRing" Property="BorderBrush" Value="#3DDC97"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
