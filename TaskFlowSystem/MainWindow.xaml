<Window x:Class="TaskFlowSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="TaskFlowSystem"
        Width="1440"
        Height="1100"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0A0F0C"
        FontFamily="Segoe UI"
        Loaded="OnWindowLoaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Палитра -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3DDC97"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF6EF"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7E9186"/>

        <!-- Градиенты -->
        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D1712" Offset="0"/>
            <GradientStop Color="#0A100D" Offset="0.55"/>
            <GradientStop Color="#0C1410" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopBarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#111C16" Offset="0"/>
            <GradientStop Color="#0D1511" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1A14" Offset="0"/>
            <GradientStop Color="#0C1410" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#131E17" Offset="0"/>
            <GradientStop Color="#0F1712" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4BE3A5" Offset="0"/>
            <GradientStop Color="#17C29A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonHoverGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#63EDB4" Offset="0"/>
            <GradientStop Color="#25D2A8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentTileGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3DDC97" Offset="0"/>
            <GradientStop Color="#0FA583" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GreenTileGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B4A38" Offset="0"/>
            <GradientStop Color="#123226" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AmberTileGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4A3418" Offset="0"/>
            <GradientStop Color="#33230F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RedTileGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#47232E" Offset="0"/>
            <GradientStop Color="#331821" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActiveNavGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E3A2D" Offset="0"/>
            <GradientStop Color="#162B22" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProCardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#14301F" Offset="0"/>
            <GradientStop Color="#0E1F18" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EAF6EF" Offset="0"/>
            <GradientStop Color="#9FE8C6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LineGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#003DDC97" Offset="0"/>
            <GradientStop Color="#663DDC97" Offset="0.5"/>
            <GradientStop Color="#003DDC97" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ScrollBarThumbGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2C5A44" Offset="0"/>
            <GradientStop Color="#1F4634" Offset="1"/>
        </LinearGradientBrush>

        <!-- Градиенты колонок доски -->
        <LinearGradientBrush x:Key="TodoColumnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#141D17" Offset="0"/>
            <GradientStop Color="#101813" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DoingColumnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#12211B" Offset="0"/>
            <GradientStop Color="#0E1A14" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ReviewColumnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#211A11" Offset="0"/>
            <GradientStop Color="#181309" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DoneColumnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#10231A" Offset="0"/>
            <GradientStop Color="#0C1B13" Offset="1"/>
        </LinearGradientBrush>

        <!-- Основные стили кнопок -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="#06251A"/>
            <Setter Property="Background" Value="{StaticResource PrimaryButtonGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryButtonHoverGradient}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#121C16"/>
            <Setter Property="Foreground" Value="#8AA394"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderBrush="#22332B"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1B2E24"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2E4A3B"/>
                                <Setter Property="Foreground" Value="#6EE7B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#8CA096"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#17241D"/>
                                <Setter Property="Foreground" Value="#DFF3E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#7E9186"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="12,8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="#17251D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8AA394"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PlainBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PlainBorder" Property="Background" Value="#18251E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки управления окном (виндовские) -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8AA394"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WinBorder"
                                Background="Transparent"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WinBorder" Property="Background" Value="#1B2E24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource ScrollBarThumbGradient}"
                                                        CornerRadius="5" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowGradient}"
            BorderBrush="#1E2B24"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0"
                    Background="{StaticResource TopBarGradient}"
                    CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="236"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Логотип -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="24,0,0,0">
                        <Button Style="{StaticResource PlainButton}"
                                HorizontalContentAlignment="Left"
                                Click="OnLogoClick">
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                <Border Width="44" Height="44"
                                        Background="{StaticResource AccentTileGradient}"
                                        CornerRadius="12">
                                    <TextBlock Text="TF"
                                               Foreground="#06251A"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="TaskFlow" FontSize="22" FontWeight="Bold" Foreground="#EAF6EF"/>
                                    <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Foreground="#5F7A6C"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Поиск -->
                    <Border Grid.Column="1"
                            Width="560"
                            Height="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#121C16"
                            BorderBrush="#22332B"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid Margin="18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="24" Foreground="#5F7A6C" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14"
                                     Foreground="#7E9186"
                                     CaretBrush="#3DDC97"
                                     GotFocus="OnSearchGotFocus"
                                     LostFocus="OnSearchLostFocus"
                                     KeyDown="OnSearchKeyDown"
                                     Text="Поиск задач, проектов и участников..."/>
                            <Button Grid.Column="2"
                                    Padding="10,4"
                                    Background="#1A2820"
                                    BorderBrush="#2C4436"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="OnSearchShortcutClick"
                                    ToolTip="Поиск">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="⌘ K" FontSize="12" Foreground="#7E9186"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Профиль + кнопки окон справа -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button Style="{StaticResource IconButton}"
                                Content="◌"
                                ToolTip="Уведомления"
                                Click="OnNotificationsClick"/>
                        <Button Style="{StaticResource IconButton}"
                                Margin="10,0,16,0"
                                Content="?"
                                ToolTip="Помощь"
                                Click="OnHelpClick"/>
                        <Button x:Name="ProfileButton"
                                Style="{StaticResource PlainButton}"
                                Padding="6,4"
                                AutomationProperties.Name="Профиль"
                                Click="OnProfileClick"
                                ToolTip="Профиль (нажмите, чтобы сменить)">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="ProfileAvatarBorder"
                                        Width="44" Height="44" CornerRadius="22"
                                        Background="{StaticResource AccentTileGradient}">
                                    <TextBlock x:Name="ProfileAvatarText"
                                               Text="?"
                                               FontWeight="Bold"
                                               Foreground="#06251A"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfileNameText"
                                               Text="Пользователь"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#EAF6EF"/>
                                    <TextBlock x:Name="ProfileRoleText"
                                               Text="Гость"
                                               FontSize="12"
                                               Foreground="#7E9186"/>
                                </StackPanel>
                                <TextBlock Text="⌄"
                                           Margin="10,0,0,0"
                                           FontSize="18"
                                           Foreground="#7E9186"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Виндовские кнопки управления окном -->
                        <Button x:Name="BtnMinimize"
                                Style="{StaticResource WindowControlButton}"
                                Margin="12,0,0,0"
                                Content="─"
                                Foreground="#8AA394"
                                Click="OnMinimizeClick"
                                ToolTip="Свернуть"/>
                        <Button x:Name="BtnMaximize"
                                Style="{StaticResource WindowControlButton}"
                                Margin="8,0,0,0"
                                Content="□"
                                Foreground="#8AA394"
                                Click="OnMaximizeClick"
                                ToolTip="Развернуть"/>
                        <Button x:Name="BtnClose"
                                Style="{StaticResource WindowControlButton}"
                                Margin="8,0,0,0"
                                Content="×"
                                Foreground="#8AA394"
                                Click="OnCloseClick"
                                ToolTip="Закрыть">
                        </Button>
                    </StackPanel>

                    <!-- Светящаяся линия под шапкой -->
                    <Rectangle Height="1"
                               VerticalAlignment="Bottom"
                               IsHitTestVisible="False"
                               Fill="{StaticResource LineGradient}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Боковое меню -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarGradient}"
                        BorderBrush="#1C2B23"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,12">
                    <Grid Margin="22,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Button x:Name="NavOverviewButton"
                                    Style="{StaticResource NavButton}"
                                    Background="{StaticResource ActiveNavGradient}"
                                    Foreground="#6EE7B7"
                                    Click="OnOverviewClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="▦" FontSize="20"/>
                                    <TextBlock Grid.Column="1" Text="Обзор" FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="NavTasksButton"
                                    Style="{StaticResource NavButton}"
                                    Click="OnMyTasksClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="✓" FontSize="18"/>
                                    <TextBlock Grid.Column="1" Text="Мои задачи"/>
                                </Grid>
                            </Button>

                            <Button x:Name="NavInboxButton"
                                    Style="{StaticResource NavButton}"
                                    Click="OnInboxClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="▣" FontSize="18"/>
                                    <TextBlock Grid.Column="1" Text="Входящие"/>
                                </Grid>
                            </Button>

                            <Button x:Name="NavCalendarButton"
                                    Style="{StaticResource NavButton}"
                                    Click="OnCalendarClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="□" FontSize="20"/>
                                    <TextBlock Grid.Column="1" Text="Календарь"/>
                                </Grid>
                            </Button>

                            <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО"
                                       Margin="14,28,0,10"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#4E6157"/>

                            <Button Style="{StaticResource NavButton}" Click="OnProjectsClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="◫" FontSize="18"/>
                                    <TextBlock Grid.Column="1" Text="Проекты"/>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource PlainButton}"
                                            Width="28"
                                            Height="28"
                                            Foreground="#3DDC97"
                                            FontSize="20"
                                            Click="OnAddProjectClick"
                                            Content="+"/>
                                </Grid>
                            </Button>

                            <TextBlock x:Name="EmptyProjectsHint"
                                       Margin="16,6,0,0"
                                       Text="Проекты пока не созданы"
                                       FontSize="13"
                                       Foreground="#4E6157"/>

                            <TextBlock Text="КОМАНДА"
                                       Margin="14,28,0,10"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#4E6157"/>

                            <Button Style="{StaticResource NavButton}" Click="OnTeamClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="♙" FontSize="20"/>
                                    <TextBlock Grid.Column="1" Text="Участники"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource NavButton}" Click="OnReportsClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="◈" FontSize="18"/>
                                    <TextBlock Grid.Column="1" Text="Отчёты"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource NavButton}" Click="OnSettingsClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚙" FontSize="18"/>
                                    <TextBlock Grid.Column="1" Text="Настройки"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="2"
                                Background="{StaticResource ProCardGradient}"
                                BorderBrush="#2A4A3A"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="18">
                            <StackPanel>
                                <Border Width="40" Height="40" HorizontalAlignment="Left"
                                        Background="{StaticResource AccentTileGradient}"
                                        CornerRadius="12">
                                    <TextBlock Text="✦" Foreground="#06251A" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Перейдите на Pro"
                                           Margin="0,14,0,6"
                                           Foreground="#EAF6EF"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Больше проектов, аналитики и возможностей команды."
                                           Foreground="#8AA394"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                                <Button Margin="0,16,0,0"
                                        Height="42"
                                        Style="{StaticResource RoundedButton}"
                                        Padding="12,6"
                                        Content="Узнать больше"
                                        Click="OnUpgradeClick"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Контент -->
                <Grid Grid.Column="1" Margin="34,28,34,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="PageTitleText"
                                       Text="Обзор"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TitleGradient}"/>
                            <TextBlock x:Name="PageSubtitleText"
                                       Margin="0,8,0,0"
                                       Text="Добавьте первую задачу, чтобы начать работу"
                                       FontSize="16"
                                       Foreground="#7E9186"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource RoundedButton}"
                                VerticalAlignment="Center"
                                Click="OnCreateTaskClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" Margin="0,-2,10,0" FontSize="22"/>
                                <TextBlock Text="Новая задача"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Карточки статистики -->
                    <Grid Grid.Row="1" Margin="0,28,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,12,0" Padding="20"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="16" BorderBrush="#22302A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50"
                                        Background="{StaticResource AccentTileGradient}"
                                        CornerRadius="14">
                                    <TextBlock Text="▦" FontSize="24" Foreground="#06251A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="Всего задач" Foreground="#7E9186" FontSize="13"/>
                                    <TextBlock x:Name="TotalTasksText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EAF6EF"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Margin="6,0,8,0" Padding="20"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="16" BorderBrush="#22302A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50"
                                        Background="{StaticResource AmberTileGradient}"
                                        CornerRadius="14">
                                    <TextBlock Text="◔" FontSize="26" Foreground="#FFB467"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="В работе" Foreground="#7E9186" FontSize="13"/>
                                    <TextBlock x:Name="InProgressTasksText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EAF6EF"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Margin="8,0,6,0" Padding="20"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="16" BorderBrush="#22302A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50"
                                        Background="{StaticResource GreenTileGradient}"
                                        CornerRadius="14">
                                    <TextBlock Text="✓" FontSize="25" Foreground="#54DFAB"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="Выполнено" Foreground="#7E9186" FontSize="13"/>
                                    <TextBlock x:Name="CompletedTasksText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EAF6EF"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Margin="12,0,0,0" Padding="20"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="16" BorderBrush="#22302A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50"
                                        Background="{StaticResource RedTileGradient}"
                                        CornerRadius="14">
                                    <TextBlock Text="!" FontSize="25" FontWeight="Bold" Foreground="#FF7187"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="Просрочено" Foreground="#7E9186" FontSize="13"/>
                                    <TextBlock x:Name="OverdueTasksText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EAF6EF"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Переключатель видов -->
                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ViewBoardButton"
                                    Style="{StaticResource NavButton}"
                                    Width="110" Height="46"
                                    Background="{StaticResource ActiveNavGradient}" Foreground="#6EE7B7"
                                    HorizontalContentAlignment="Center"
                                    Click="OnBoardViewClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦" Margin="0,0,10,0"/>
                                    <TextBlock Text="Доска" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ViewListButton"
                                    Style="{StaticResource NavButton}"
                                    Width="110" Height="46"
                                    HorizontalContentAlignment="Center"
                                    Click="OnListViewClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☷" Margin="0,0,10,0"/>
                                    <TextBlock Text="Список"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ViewCalendarButton"
                                    Style="{StaticResource NavButton}"
                                    Width="130" Height="46"
                                    HorizontalContentAlignment="Center"
                                    Click="OnCalendarViewClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="□" Margin="0,0,10,0"/>
                                    <TextBlock Text="Календарь"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ViewTimelineButton"
                                    Style="{StaticResource NavButton}"
                                    Width="120" Height="46"
                                    HorizontalContentAlignment="Center"
                                    Click="OnTimelineViewClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◫" Margin="0,0,10,0"/>
                                    <TextBlock Text="График"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Width="110" Margin="0,0,10,0" Click="OnFilterClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="≡" Margin="0,0,10,0"/>
                                    <TextBlock Text="Фильтр" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="128" Click="OnSortClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↕" Margin="0,0,10,0"/>
                                    <TextBlock Text="Сортировка" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Доска: колонки фиксированной ширины, компактные -->
                    <ScrollViewer Grid.Row="3"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,4">

                            <!-- К выполнению -->
                            <Border Width="340" MinHeight="260"
                                    Margin="0,0,16,0" Padding="16"
                                    Background="{StaticResource TodoColumnGradient}"
                                    BorderBrush="#24322A" BorderThickness="1"
                                    CornerRadius="18">
                                <StackPanel>
                                    <Grid Margin="6,0,6,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="11" Height="11" Fill="#8FA79B" Margin="0,0,10,0"/>
                                            <TextBlock Text="К выполнению" FontWeight="SemiBold" Foreground="#E4EFE8" FontSize="15"/>
                                            <Border Margin="10,-2,0,0" Padding="8,2" Background="#1C2A22" CornerRadius="9">
                                                <TextBlock x:Name="TodoCountText" Text="0" FontSize="11" Foreground="#A9BDB1"/>
                                            </Border>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right"
                                                Style="{StaticResource PlainButton}"
                                                Width="34" Height="34"
                                                FontSize="20" Content="+"
                                                Foreground="#8AA394"
                                                Click="OnAddTodoTaskClick"/>
                                    </Grid>
                                    <StackPanel x:Name="TodoTasksPanel" VerticalAlignment="Top">
                                        <TextBlock Margin="10,24,10,12"
                                                   Text="Нет задач"
                                                   FontSize="15"
                                                   Foreground="#5F7A6C"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="+  Добавить задачу"
                                            Click="OnAddTodoTaskClick"/>
                                </StackPanel>
                            </Border>

                            <!-- В работе -->
                            <Border Width="340" MinHeight="260"
                                    Margin="0,0,16,0" Padding="16"
                                    Background="{StaticResource DoingColumnGradient}"
                                    BorderBrush="#25493A" BorderThickness="1"
                                    CornerRadius="18">
                                <StackPanel>
                                    <Grid Margin="6,0,6,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="11" Height="11" Fill="#3DDC97" Margin="0,0,10,0"/>
                                            <TextBlock Text="В работе" FontWeight="SemiBold" Foreground="#E4EFE8" FontSize="15"/>
                                            <Border Margin="10,-2,0,0" Padding="8,2" Background="#1D3A2C" CornerRadius="9">
                                                <TextBlock x:Name="DoingCountText" Text="0" FontSize="11" Foreground="#7DE8BC"/>
                                            </Border>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right"
                                                Style="{StaticResource PlainButton}"
                                                Width="34" Height="34"
                                                FontSize="20" Content="+"
                                                Foreground="#3DDC97"
                                                Click="OnAddInProgressTaskClick"/>
                                    </Grid>
                                    <StackPanel x:Name="InProgressTasksPanel" VerticalAlignment="Top">
                                        <TextBlock Margin="10,24,10,12"
                                                   Text="Нет задач"
                                                   FontSize="15"
                                                   Foreground="#5F7A6C"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource GhostButton}"
                                            Foreground="#5FE0AC"
                                            Content="+  Добавить задачу"
                                            Click="OnAddInProgressTaskClick"/>
                                </StackPanel>
                            </Border>

                            <!-- На проверке -->
                            <Border Width="340" MinHeight="260"
                                    Margin="0,0,16,0" Padding="16"
                                    Background="{StaticResource ReviewColumnGradient}"
                                    BorderBrush="#3E3220" BorderThickness="1"
                                    CornerRadius="18">
                                <StackPanel>
                                    <Grid Margin="6,0,6,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="11" Height="11" Fill="#FFAB5C" Margin="0,0,10,0"/>
                                            <TextBlock Text="На проверке" FontWeight="SemiBold" Foreground="#E4EFE8" FontSize="15"/>
                                            <Border Margin="10,-2,0,0" Padding="8,2" Background="#3A2C1C" CornerRadius="9">
                                                <TextBlock x:Name="ReviewCountText" Text="0" FontSize="11" Foreground="#FFBE7C"/>
                                            </Border>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right"
                                                Style="{StaticResource PlainButton}"
                                                Width="34" Height="34"
                                                FontSize="20" Content="+"
                                                Foreground="#FFBB78"
                                                Click="OnAddReviewTaskClick"/>
                                    </Grid>
                                    <StackPanel x:Name="ReviewTasksPanel" VerticalAlignment="Top">
                                        <TextBlock Margin="10,24,10,12"
                                                   Text="Нет задач"
                                                   FontSize="15"
                                                   Foreground="#5F7A6C"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource GhostButton}"
                                            Foreground="#F0A868"
                                            Content="+  Добавить задачу"
                                            Click="OnAddReviewTaskClick"/>
                                </StackPanel>
                            </Border>

                            <!-- Готово -->
                            <Border Width="340" MinHeight="260"
                                    Margin="0,0,16,0" Padding="16"
                                    Background="{StaticResource DoneColumnGradient}"
                                    BorderBrush="#234A37" BorderThickness="1"
                                    CornerRadius="18">
                                <StackPanel>
                                    <Grid Margin="6,0,6,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="11" Height="11" Fill="#37D49A" Margin="0,0,10,0"/>
                                            <TextBlock Text="Готово" FontWeight="SemiBold" Foreground="#E4EFE8" FontSize="15"/>
                                            <Border Margin="10,-2,0,0" Padding="8,2" Background="#1A3A2B" CornerRadius="9">
                                                <TextBlock x:Name="DoneCountText" Text="0" FontSize="11" Foreground="#61E0B0"/>
                                            </Border>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right"
                                                Style="{StaticResource PlainButton}"
                                                Width="34" Height="34"
                                                FontSize="20" Content="+"
                                                Foreground="#61E0B0"
                                                Click="OnAddDoneTaskClick"/>
                                    </Grid>
                                    <StackPanel x:Name="DoneTasksPanel" VerticalAlignment="Top">
                                        <TextBlock Margin="10,24,10,12"
                                                   Text="Нет задач"
                                                   FontSize="15"
                                                   Foreground="#5F7A6C"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource GhostButton}"
                                            Foreground="#56D9A4"
                                            Content="+  Добавить задачу"
                                            Click="OnAddDoneTaskClick"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>