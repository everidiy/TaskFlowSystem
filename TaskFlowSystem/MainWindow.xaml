<Window x:Class="TaskFlowSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="TaskFlowSystem"
        Width="1440"
        Height="1100"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0A0F0C"
        FontFamily="Segoe UI"
        Loaded="OnWindowLoaded"
        StateChanged="OnWindowStateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Палитра -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3DDC97"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF6EF"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7E9186"/>

        <!-- Градиенты -->
        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D1712" Offset="0"/>
            <GradientStop Color="#0A100D" Offset="0.55"/>
            <GradientStop Color="#0C1410" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopBarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#111C16" Offset="0"/>
            <GradientStop Color="#0D1511" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1A14" Offset="0"/>
            <GradientStop Color="#0C1410" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#131E17" Offset="0"/>
            <GradientStop Color="#0F1712" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4BE3A5" Offset="0"/>
            <GradientStop Color="#17C29A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonHoverGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#63EDB4" Offset="0"/>
            <GradientStop Color="#25D2A8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentTileGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3DDC97" Offset="0"/>
            <GradientStop Color="#0FA583" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GreenTileGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B4A38" Offset="0"/>
            <GradientStop Color="#123226" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AmberTileGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4A3418" Offset="0"/>
            <GradientStop Color="#33230F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RedTileGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#47232E" Offset="0"/>
            <GradientStop Color="#331821" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActiveNavGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E3A2D" Offset="0"/>
            <GradientStop Color="#162B22" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProCardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#14301F" Offset="0"/>
            <GradientStop Color="#0E1F18" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EAF6EF" Offset="0"/>
            <GradientStop Color="#9FE8C6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LineGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#003DDC97" Offset="0"/>
            <GradientStop Color="#663DDC97" Offset="0.5"/>
            <GradientStop Color="#003DDC97" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ScrollBarThumbGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2C5A44" Offset="0"/>
            <GradientStop Color="#1F4634" Offset="1"/>
        </LinearGradientBrush>

        <!-- Градиенты колонок доски -->

        <!-- К выполнению -->
        <LinearGradientBrush x:Key="TodoColumnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#141D17" Offset="0"/>
            <GradientStop Color="#101813" Offset="1"/>
        </LinearGradientBrush>

        <!-- В работе: старый янтарный цвет проверки -->
        <LinearGradientBrush x:Key="DoingColumnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#211A11" Offset="0"/>
            <GradientStop Color="#181309" Offset="1"/>
        </LinearGradientBrush>

        <!-- На проверке: новый синий цвет -->
        <LinearGradientBrush x:Key="ReviewColumnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#14202D" Offset="0"/>
            <GradientStop Color="#0E1823" Offset="1"/>
        </LinearGradientBrush>

        <!-- Готово -->
        <LinearGradientBrush x:Key="DoneColumnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#10231A" Offset="0"/>
            <GradientStop Color="#0C1B13" Offset="1"/>
        </LinearGradientBrush>

        <!-- Стиль по умолчанию: не допускаем стандартный фиолетовый акцент WPF -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#06251A"/>
            <Setter Property="Background" Value="{StaticResource PrimaryButtonGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DefaultButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DefaultButtonBorder" Property="Background"
                                        Value="{StaticResource PrimaryButtonHoverGradient}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DefaultButtonBorder" Property="Background" Value="#12A879"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DefaultButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Основные стили кнопок -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="#06251A"/>
            <Setter Property="Background" Value="{StaticResource PrimaryButtonGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryButtonHoverGradient}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#12A879"/>
                                <Setter TargetName="ButtonBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#121C16"/>
            <Setter Property="Foreground" Value="#8AA394"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderBrush="#22332B"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#193D2D"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3DDC97"/>
                                <Setter Property="Foreground" Value="#6EE7B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#245A40"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#63EDB4"/>
                                <Setter Property="Foreground" Value="#A7F3D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#8CA096"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Наведение -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#173A2B"/>
                                <Setter Property="Foreground" Value="#6EE7B7"/>
                            </Trigger>

                            <!-- Нажатие -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#245A40"/>
                                <Setter Property="Foreground" Value="#A7F3D0"/>
                            </Trigger>

                            <!-- Отключённая кнопка -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#7E9186"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="12,8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="#173A2B"/>
                                <Setter Property="Foreground" Value="#6EE7B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="#245A40"/>
                                <Setter Property="Foreground" Value="#A7F3D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8AA394"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PlainBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PlainBorder" Property="Background" Value="#173A2B"/>
                                <Setter Property="Foreground" Value="#6EE7B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PlainBorder" Property="Background" Value="#245A40"/>
                                <Setter Property="Foreground" Value="#A7F3D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки управления окном (виндовские) -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8AA394"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WinBorder"
                                Background="Transparent"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WinBorder" Property="Background" Value="#173A2B"/>
                                <Setter Property="Foreground" Value="#6EE7B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="WinBorder" Property="Background" Value="#245A40"/>
                                <Setter Property="Foreground" Value="#A7F3D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource ScrollBarThumbGradient}"
                                                        CornerRadius="5" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- К выполнению: Поле -->
        <Style x:Key="TodoColumnStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TodoColumnGradient}"/>
            <Setter Property="BorderBrush" Value="#24322A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#19271F"/>
                    <Setter Property="BorderBrush" Value="#8FA79B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- В работе: Поле -->
        <Style x:Key="DoingColumnStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DoingColumnGradient}"/>
            <Setter Property="BorderBrush" Value="#3E3220"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#302416"/>
                    <Setter Property="BorderBrush" Value="#FFAB5C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- На проверке: Поле -->
        <Style x:Key="ReviewColumnStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ReviewColumnGradient}"/>
            <Setter Property="BorderBrush" Value="#263B50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C3044"/>
                    <Setter Property="BorderBrush" Value="#60A5FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Готово: Поле -->
        <Style x:Key="DoneColumnStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DoneColumnGradient}"/>
            <Setter Property="BorderBrush" Value="#234A37"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#163526"/>
                    <Setter Property="BorderBrush" Value="#37D49A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- К выполнению: Кнопка -->
        <Style x:Key="TodoGhostButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8FA79B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background" Value="#24372D"/>
                                <Setter Property="Foreground" Value="#B5CBBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background" Value="#354D40"/>
                                <Setter Property="Foreground" Value="#E0F0E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- В работе: Кнопка -->
        <Style x:Key="DoingGhostButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F0A868"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background" Value="#49321B"/>
                                <Setter Property="Foreground" Value="#FFC184"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background" Value="#624323"/>
                                <Setter Property="Foreground" Value="#FFE0B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- На проверке: Кнопка -->
        <Style x:Key="ReviewGhostButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5F7A96"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background" Value="#263B50"/>
                                <Setter Property="Foreground" Value="#8FAFCB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background" Value="#354F68"/>
                                <Setter Property="Foreground" Value="#C1D5E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Готово: Кнопка -->
        <Style x:Key="DoneGhostButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#56D9A4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background" Value="#1A4933"/>
                                <Setter Property="Foreground" Value="#61E0B0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background" Value="#246044"/>
                                <Setter Property="Foreground" Value="#A7F3D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowGradient}"
            BorderBrush="#1E2B24"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0"
                    Background="{StaticResource TopBarGradient}"
                    CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="236"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Логотип -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="24,0,0,0">
                        <Button Style="{StaticResource PlainButton}"
                                HorizontalContentAlignment="Left"
                                Click="OnLogoClick">
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                <Border Width="44" Height="44"
                                        Background="{StaticResource AccentTileGradient}"
                                        CornerRadius="12">
                                    <TextBlock Text="TF"
                                               Foreground="#06251A"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="TaskFlow" FontSize="22" FontWeight="Bold" Foreground="#EAF6EF"/>
                                    <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Foreground="#5F7A6C"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Поиск -->
                    <Border Grid.Column="1"
                            Width="560"
                            Height="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#121C16"
                            BorderBrush="#22332B"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid Margin="18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="24" Foreground="#5F7A6C" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14"
                                     Foreground="#7E9186"
                                     CaretBrush="#3DDC97"
                                     GotFocus="OnSearchGotFocus"
                                     LostFocus="OnSearchLostFocus"
                                     KeyDown="OnSearchKeyDown"
                                     Text="Поиск задач, проектов и участников..."/>
                            <Button Grid.Column="2"
                                    Padding="10,4"
                                    Background="#1A2820"
                                    BorderBrush="#2C4436"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="OnSearchShortcutClick"
                                    ToolTip="Поиск">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#173A2B"/>
                                                <Setter Property="BorderBrush" Value="#3DDC97"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#245A40"/>
                                                <Setter Property="BorderBrush" Value="#63EDB4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="⌘ K" FontSize="12" Foreground="#7E9186"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Профиль + кнопки окон справа -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button Style="{StaticResource IconButton}"
                                Content="◌"
                                ToolTip="Уведомления"
                                Click="OnNotificationsClick"/>
                        <Button Style="{StaticResource IconButton}"
                                Margin="10,0,16,0"
                                Content="?"
                                ToolTip="Помощь"
                                Click="OnHelpClick"/>
                        <Button x:Name="ProfileButton"
                                Style="{StaticResource PlainButton}"
                                Padding="6,4"
                                AutomationProperties.Name="Выбор пользователя"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnProfileClick"
                                ToolTip="Профиль (нажмите, чтобы сменить)">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="ProfileAvatarBorder"
                                        Width="44" Height="44" CornerRadius="22"
                                        Background="{StaticResource AccentTileGradient}">
                                    <TextBlock x:Name="ProfileAvatarText"
                                               Text="?"
                                               FontWeight="Bold"
                                               Foreground="#06251A"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfileNameText"
                                               Text="Пользователь"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#EAF6EF"
                                               MaxWidth="180"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ProfileDescriptionText"
                                               Text="Локальный профиль"
                                               FontSize="12"
                                               Foreground="#7E9186"
                                               MaxWidth="180"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="☰"
                                           Margin="10,0,0,0"
                                           FontSize="14"
                                           Foreground="#7E9186"
                                           VerticalAlignment="Center" Height="21"/>
                            </StackPanel>
                        </Button>

                        <!-- Виндовские кнопки управления окном -->
                        <Button x:Name="BtnMinimize"
                                Style="{StaticResource WindowControlButton}"
                                Margin="12,0,0,0"
                                Content="─"
                                Foreground="#8AA394"
                                AutomationProperties.Name="Свернуть окно"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnMinimizeClick"
                                ToolTip="Свернуть"/>
                        <Button x:Name="BtnMaximize"
                                Style="{StaticResource WindowControlButton}"
                                Margin="8,0,0,0"
                                Content="□"
                                Foreground="#8AA394"
                                AutomationProperties.Name="Развернуть окно"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnMaximizeClick"
                                ToolTip="Развернуть"/>
                        <Button x:Name="BtnClose"
                                Style="{StaticResource WindowControlButton}"
                                Margin="8,0,0,0"
                                Content="×"
                                Foreground="#8AA394"
                                AutomationProperties.Name="Закрыть окно"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnCloseClick"
                                ToolTip="Закрыть">
                        </Button>
                    </StackPanel>

                    <!-- Светящаяся линия под шапкой -->
                    <Rectangle Height="1"
                               VerticalAlignment="Bottom"
                               IsHitTestVisible="False"
                               Fill="{StaticResource LineGradient}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Боковое меню -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarGradient}"
                        BorderBrush="#1C2B23"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,12">
                    <Grid Margin="22,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Button x:Name="NavOverviewButton"
                                    Style="{StaticResource NavButton}"
                                    Background="{StaticResource ActiveNavGradient}"
                                    Foreground="#6EE7B7"
                                    ToolTip="Просмотреть все задачи"
                                    Click="OnOverviewClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⌂" TextAlignment="Center" FontSize="20"/>
                                    <TextBlock Grid.Column="1" Text="Обзор" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </Grid>
                            </Button>

                            <Button x:Name="NavTasksButton"
                                    Style="{StaticResource NavButton}"
                                    ToolTip="Просмотреть все ваши задачи"
                                    Click="OnMyTasksClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="✓" TextAlignment="Center" FontSize="18"/>
                                    <TextBlock Grid.Column="1" Text="Мои задачи" Margin="0,2,0,0"/>
                                </Grid>
                            </Button>

                            <Button x:Name="NavInboxButton"
                                    Style="{StaticResource NavButton}"
                                    ToolTip="Прочитать входящие сообщения"
                                    Click="OnInboxClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="✉️" TextAlignment="Center" FontSize="18"/>
                                    <TextBlock Grid.Column="1" Text="Входящие" Margin="0,2,0,0"/>
                                </Grid>
                            </Button>

                            <Button x:Name="NavCalendarButton"
                                    Style="{StaticResource NavButton}"
                                    ToolTip="Просмотреть календарь с задачами"
                                    Click="OnCalendarClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📆" TextAlignment="Center" FontSize="18"/>
                                    <TextBlock Grid.Column="1" Text="Календарь" Margin="0,2,0,0"/>
                                </Grid>
                            </Button>

                            <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО"
                                       Margin="14,28,0,10"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#4E6157"/>

                            <Button Style="{StaticResource NavButton}" 
                                    ToolTip="Просмотреть все проекты"
                                    Click="OnProjectsClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🗎" TextAlignment="Center" FontSize="18"/>
                                    <TextBlock Grid.Column="1" Text="Проекты" Margin="0,2,0,0"/>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource PlainButton}"
                                            Width="28"
                                            Height="28"
                                            Foreground="#3DDC97"
                                            FontSize="20"
                                            ToolTip="Создать проект"
                                            Click="OnAddProjectClick"
                                            Content="+" HorizontalAlignment="Center" Margin="0,-3,0,3"/>
                                </Grid>
                            </Button>

                            <TextBlock x:Name="EmptyProjectsHint"
                                       Margin="16,6,0,0"
                                       Text="Проекты пока не созданы"
                                       FontSize="13"
                                       Foreground="#4E6157"/>

                            <TextBlock Text="КОМАНДА"
                                       Margin="14,28,0,10"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#4E6157"/>

                            <Button Style="{StaticResource NavButton}"
                                    ToolTip="Просмотреть всех участников"
                                    Click="OnTeamClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="👤" TextAlignment="Center" FontSize="20"/>
                                    <TextBlock Grid.Column="1" Text="Участники" Margin="0,3,0,0"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource NavButton}" 
                                    ToolTip="Просмотреть отчёты"
                                    Click="OnReportsClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📄" TextAlignment="Center" FontSize="18"/>
                                    <TextBlock Grid.Column="1" Text="Отчёты" Margin="0,2,0,0"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource NavButton}" 
                                    ToolTip="Открыть настройки"
                                    Click="OnSettingsClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚙" TextAlignment="Center" FontSize="18"/>
                                    <TextBlock Grid.Column="1" Text="Настройки" Margin="0,2,0,0"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="2"
                                Background="{StaticResource ProCardGradient}"
                                BorderBrush="#2A4A3A"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="18">
                            <StackPanel>
                                <Border Width="40" Height="40" HorizontalAlignment="Left"
                                        Background="{StaticResource AccentTileGradient}"
                                        CornerRadius="12">
                                    <TextBlock Text="✦" Foreground="#06251A" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Перейдите на Pro"
                                           Margin="0,14,0,6"
                                           Foreground="#EAF6EF"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Больше проектов, аналитики и возможностей команды."
                                           Foreground="#8AA394"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                                <Button Margin="0,16,0,0"
                                        Height="42"
                                        Style="{StaticResource RoundedButton}"
                                        Padding="12,6"
                                        Content="Узнать больше"
                                        ToolTip="Узнать больше о Pro подписке"
                                        Click="OnUpgradeClick"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Контент -->
                <Grid Grid.Column="1" Margin="34,28,34,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="PageTitleText"
                                       Text="Обзор"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TitleGradient}"/>
                            <TextBlock x:Name="PageSubtitleText"
                                       Margin="0,8,0,0"
                                       Text="Добавьте первую задачу, чтобы начать работу"
                                       FontSize="16"
                                       Foreground="#7E9186"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource RoundedButton}"
                                VerticalAlignment="Center"
                                ToolTip="Добавить новую задачу"
                                Click="OnCreateTaskClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" TextAlignment="Center" Margin="0, -6, 10,0" FontSize="22"/>
                                <TextBlock Text="Новая задача"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Карточки статистики -->
                    <Grid Grid.Row="1" Margin="0,28,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,12,0" Padding="20"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="16" BorderBrush="#22302A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50"
                                        Background="{StaticResource AccentTileGradient}"
                                        CornerRadius="14">
                                    <TextBlock Text="▦" FontSize="24" Foreground="#06251A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="Всего задач" Foreground="#7E9186" FontSize="13"/>
                                    <TextBlock x:Name="TotalTasksText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EAF6EF"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Margin="6,0,8,0" Padding="20"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="16" BorderBrush="#22302A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50"
                                        Background="{StaticResource AmberTileGradient}"
                                        CornerRadius="14">
                                    <TextBlock Text="◔" FontSize="26" Foreground="#FFB467"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="В работе" Foreground="#7E9186" FontSize="13"/>
                                    <TextBlock x:Name="InProgressTasksText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EAF6EF"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Margin="8,0,6,0" Padding="20"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="16" BorderBrush="#22302A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50"
                                        Background="{StaticResource GreenTileGradient}"
                                        CornerRadius="14">
                                    <TextBlock Text="✓" FontSize="25" Foreground="#54DFAB"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="Выполнено" Foreground="#7E9186" FontSize="13"/>
                                    <TextBlock x:Name="CompletedTasksText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EAF6EF"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Margin="12,0,0,0" Padding="20"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="16" BorderBrush="#22302A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50"
                                        Background="{StaticResource RedTileGradient}"
                                        CornerRadius="14">
                                    <TextBlock Text="!" FontSize="25" FontWeight="Bold" Foreground="#FF7187"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="Просрочено" Foreground="#7E9186" FontSize="13"/>
                                    <TextBlock x:Name="OverdueTasksText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EAF6EF"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Переключатель видов -->
                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ViewBoardButton"
                                    Style="{StaticResource NavButton}"
                                    Width="110" Height="46"
                                    Background="{StaticResource ActiveNavGradient}" Foreground="#6EE7B7"
                                    HorizontalContentAlignment="Center"
                                    Click="OnBoardViewClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖥️" Margin="0,0,10,0"/>
                                    <TextBlock Text="Доска" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ViewListButton"
                                    Style="{StaticResource NavButton}"
                                    Width="110" Height="46"
                                    HorizontalContentAlignment="Center"
                                    Click="OnListViewClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☷" Margin="0,0,10,0"/>
                                    <TextBlock Text="Список"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ViewCalendarButton"
                                    Style="{StaticResource NavButton}"
                                    Width="130" Height="46"
                                    HorizontalContentAlignment="Center"
                                    Click="OnCalendarViewClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅" Margin="0,0,10,0"/>
                                    <TextBlock Text="Календарь"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ViewTimelineButton"
                                    Style="{StaticResource NavButton}"
                                    Width="120" Height="46"
                                    HorizontalContentAlignment="Center"
                                    Click="OnTimelineViewClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" Margin="0,0,10,0"/>
                                    <TextBlock Text="График"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" 
                                    Width="110" 
                                    Margin="0,0,10,0" 
                                    ToolTip="Фильтровать (убрать) задачи по.."
                                    Click="OnFilterClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="≡" Margin="0,-2,10,0"/>
                                    <TextBlock Text="Фильтр" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" 
                                    Width="128" 
                                    ToolTip="Сортировать (выровнять) задачи по.."
                                    Click="OnSortClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↕" Margin="0,-2,10,0"/>
                                    <TextBlock Text="Сортировка" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Доска: колонки фиксированной ширины, компактные -->
                    <Grid Grid.Row="3" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- К выполнению -->
                            <Border Grid.Column="0"
                                    MinHeight="300"
                                    Margin="0,0,12,0"
                                    Padding="18"
                                    Style="{StaticResource TodoColumnStyle}">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- Заголовок -->
                                        <RowDefinition Height="Auto"/>

                                        <!-- Список задач -->
                                        <RowDefinition Height="*"/>

                                        <!-- Добавление задачи -->
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Заголовок колонки -->
                                    <Grid Grid.Row="0" Margin="2,0,2,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="10"
                                                 Height="10"
                                                 Fill="#8FA79B"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="К выполнению"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E4EFE8"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"/>

                                        <Border Grid.Column="2"
                                                Padding="9,3"
                                                Background="#1C2A22"
                                                CornerRadius="9">
                                            <TextBlock x:Name="TodoCountText"
                                                       Text="0"
                                                       FontSize="11"
                                                       Foreground="#A9BDB1"/>
                                        </Border>
                                    </Grid>

                                    <!-- Список задач -->
                                    <Grid Grid.Row="1" MinHeight="160">
                                        <StackPanel x:Name="TodoTasksPanel"
                                                    VerticalAlignment="Top">

                                            <TextBlock Text="Нет задач"
                                                       Margin="0,45,0,8"
                                                       FontSize="15"
                                                       Foreground="#5F7A6C"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock Text="Создайте первую задачу"
                                                       FontSize="12"
                                                       Foreground="#435D4F"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Добавление задачи -->
                                    <Button Grid.Row="2"
                                            Style="{StaticResource TodoGhostButton}"
                                            Height="42"
                                            Margin="0,12,0,0"
                                            HorizontalContentAlignment="Center"
                                            Content="+  Добавить задачу"
                                            ToolTip="Создать новую задачу"
                                            Click="OnAddTodoTaskClick"/>

                                </Grid>
                            </Border>

                            <!-- В работе -->
                            <Border Grid.Column="1"
                                    MinHeight="300"
                                    Margin="0,0,12,0"
                                    Padding="18"
                                    Style="{StaticResource DoingColumnStyle}">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Заголовок -->
                                    <Grid Grid.Row="0" Margin="2,0,2,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                    <Ellipse Width="10" 
                                             Height="10"
                                             Fill="#FFAB5C"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="1"
                                                   Text="В работе"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E4EFE8"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"/>

                                    <Border Grid.Column="2"
                                            Padding="9,3"
                                            Background="#3A2C1C"
                                            CornerRadius="9">
                                        <TextBlock x:Name="DoingCountText"
                                                   Text="0"
                                                   FontSize="11"
                                                   Foreground="#FFBE7C"/>
                                    </Border>
                                </Grid>

                                    <!-- Задачи -->
                                    <Grid Grid.Row="1" MinHeight="160">
                                        <StackPanel x:Name="InProgressTasksPanel"
                                                    VerticalAlignment="Top">

                                            <TextBlock Text="Нет задач"
                                                       Margin="0,45,0,8"
                                                       FontSize="15"
                                                       Foreground="#7A6C5F"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock Text="Задачи появятся здесь"
                                                       FontSize="12"
                                                       Foreground="#75634B"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Добавление -->
                                    <Button Grid.Row="2"
                                            Style="{StaticResource DoingGhostButton}"
                                            Foreground="#F0A868"
                                            Height="42"
                                            Margin="0,12,0,0"
                                            HorizontalContentAlignment="Center"
                                            Content="+  Добавить задачу"
                                            ToolTip="Добавить задачу в работу"
                                            Click="OnAddInProgressTaskClick"/>
                                </Grid>
                            </Border>

                            <!-- На проверке -->
                            <Border Grid.Column="2"
                                    MinHeight="300"
                                    Margin="0,0,12,0"
                                    Padding="18"
                                    Style="{StaticResource ReviewColumnStyle}">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Заголовок -->
                                    <Grid Grid.Row="0" Margin="2,0,2,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                    <Ellipse Width="10" Height="10"
                                             Fill="#60A5FA"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="1"
                                                   Text="На проверке"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E4EFE8"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"/>

                                    <Border Grid.Column="2"
                                            Padding="9,3"
                                            Background="#1D3045"
                                            CornerRadius="9">
                                        <TextBlock x:Name="ReviewCountText"
                                                   Text="0"
                                                   FontSize="11"
                                                   Foreground="#93C5FD"/>
                                    </Border>
                                </Grid>

                                    <!-- Задачи -->
                                    <Grid Grid.Row="1" MinHeight="160">
                                        <StackPanel x:Name="ReviewTasksPanel"
                                                    VerticalAlignment="Top">

                                            <TextBlock Text="Нет задач"
                                                       Margin="0,45,0,8"
                                                       FontSize="15"
                                                       Foreground="#5F6C7A"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock Text="Ожидание проверки"
                                                       FontSize="12"
                                                       Foreground="#5F6C7A"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Добавление -->
                                    <Button Grid.Row="2"
                                            Style="{StaticResource ReviewGhostButton}"
                                            Foreground="#68A8F0"
                                            Height="42"
                                            Margin="0,12,0,0"
                                            HorizontalContentAlignment="Center"
                                            Content="+  Добавить задачу"
                                            ToolTip="Добавить задачу на проверку"
                                            Click="OnAddReviewTaskClick"/>
                                </Grid>
                            </Border>

                            <!-- Готово -->
                            <Border Grid.Column="3"
                                    MinHeight="300"
                                    Margin="0,0,12,0"
                                    Padding="18"
                                    Style="{StaticResource DoneColumnStyle}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок -->
                                <Grid Grid.Row="0" Margin="2,0,2,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="10"
                                                 Height="10"
                                                 Fill="#37D49A"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="1"
                                                   Text="Готово"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E4EFE8"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"/>

                                    <Border Grid.Column="2"
                                                Padding="9,3"
                                                Background="#1A3A2B"
                                                CornerRadius="9">
                                        <TextBlock x:Name="DoneCountText"
                                                       Text="0"
                                                       FontSize="11"
                                                       Foreground="#61E0B0"/>
                                    </Border>
                                </Grid>

                                <!-- Задачи -->
                                <Grid Grid.Row="1" MinHeight="160">
                                    <StackPanel x:Name="DoneTasksPanel"
                                                    VerticalAlignment="Top">

                                        <TextBlock Text="Нет задач"
                                                       Margin="0,45,0,8"
                                                       FontSize="15"
                                                       Foreground="#5F7A6C"
                                                       HorizontalAlignment="Center"/>

                                        <TextBlock Text="Выполненные задачи появятся здесь"
                                                       FontSize="12"
                                                       Foreground="#435D4F"
                                                       HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Добавление -->
                                <Button Grid.Row="2"
                                            Style="{StaticResource DoneGhostButton}"
                                            Foreground="#56D9A4"
                                            Height="42"
                                            Margin="0,12,0,0"
                                            HorizontalContentAlignment="Center"
                                            Content="+  Добавить задачу"
                                            ToolTip="Добавить выполненную задачу"
                                            Click="OnAddDoneTaskClick"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>