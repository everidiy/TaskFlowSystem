<Window x:Class="TaskFlowSystem.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskFlow — Новый профиль"
        Width="520"
        Height="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnWindowLoaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TaskFlowSystem;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="12"
            Background="{StaticResource TfWindowGradient}"
            BorderBrush="#1E2B24"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка окна -->
            <Grid Grid.Row="0" Height="44" Margin="10,6,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="TaskFlow"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#5F7A6C"/>
                    <TextBlock Text="·"
                               Margin="8,0"
                               FontSize="13"
                               Foreground="#2E4A3B"/>
                    <TextBlock Text="НОВЫЙ ПРОФИЛЬ"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#3E5A4A"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource TfWindowCloseButton}"
                        Content="✕"
                        FontSize="12"
                        Click="OnCancelClick"
                        ToolTip="Закрыть"/>
            </Grid>

            <!-- Контент -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0">
                <StackPanel Margin="44,18,44,36">

                    <!-- Логотип -->
                    <Border Width="64" Height="64"
                            HorizontalAlignment="Left"
                            Background="{StaticResource TfAccentGradient}"
                            CornerRadius="18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.45" Color="#3DDC97"/>
                        </Border.Effect>
                        <TextBlock Text="TF"
                                   Foreground="#06251A"
                                   FontWeight="Bold"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Создайте профиль"
                               Margin="0,26,0,0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource TfTitleGradient}"/>
                    <TextBlock Text="Профиль хранится только на этом компьютере. Без пароля — просто выберите его при следующем входе."
                               Margin="0,10,0,0"
                               FontSize="14"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TfMutedBrush}"/>

                    <!-- Предпросмотр: аватар + имя + описание -->
                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AvatarButton"
                                Style="{StaticResource TfAvatarPicker}"
                                AutomationProperties.Name="Добавить фотографию профиля"
                                ToolTip="Добавить фотографию"
                                Click="OnPickAvatarClick">
                            <Grid Width="84" Height="84">
                                <Border x:Name="AvatarPreview"
                                        Width="84" Height="84"
                                        Background="{StaticResource TfAccentGradient}"
                                        CornerRadius="42">
                                    <TextBlock x:Name="AvatarInitial"
                                               Text="?"
                                               Foreground="#06251A"
                                               FontWeight="Bold"
                                               FontSize="32"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="26" Height="26"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource TfAccentGradient}"
                                        BorderBrush="#0D1712"
                                        BorderThickness="2"
                                        CornerRadius="13">
                                    <TextBlock Text="+"
                                               Foreground="#06251A"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-1,0,0"/>
                                </Border>
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock x:Name="PreviewName"
                                       Text="Имя не указано"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TfFaintBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PreviewDescription"
                                       Text="Без описания"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource TfMutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="PickAvatarButton"
                                        Style="{StaticResource TfLinkButton}"
                                        Content="Загрузить фото"
                                        FontSize="13"
                                        Click="OnPickAvatarClick"
                                        AutomationProperties.Name="Загрузить фотографию профиля"/>
                                <Button x:Name="RemoveAvatarButton"
                                        Style="{StaticResource TfDangerLinkButton}"
                                        Content="Удалить"
                                        Margin="16,0,0,0"
                                        Visibility="Collapsed"
                                        Click="OnRemoveAvatarClick"
                                        AutomationProperties.Name="Удалить фотографию профиля"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Имя -->
                    <TextBlock Text="ИМЯ" Style="{StaticResource TfFieldLabel}" Margin="4,26,0,8"/>
                    <TextBox x:Name="NameBox"
                             Style="{StaticResource TfInput}"
                             AutomationProperties.Name="Имя"
                             MaxLength="40"
                             TextChanged="OnNameChanged"
                             KeyDown="OnKeyDown"/>

                    <!-- Описание -->
                    <TextBlock Text="ОПИСАНИЕ (НЕОБЯЗАТЕЛЬНО)" Style="{StaticResource TfFieldLabel}" Margin="4,20,0,8"/>
                    <TextBox x:Name="DescriptionBox"
                             Style="{StaticResource TfInput}"
                             AutomationProperties.Name="Описание"
                             MaxLength="80"
                             TextChanged="OnDescriptionChanged"
                             KeyDown="OnKeyDown"/>
                    <TextBlock Text="Коротко о себе — это увидят при выборе профиля."
                               Margin="4,8,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TfFaintBrush}"/>

                    <!-- Цвет аватара -->
                    <TextBlock Text="АКЦЕНТНЫЙ ЦВЕТ" Style="{StaticResource TfFieldLabel}" Margin="4,22,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="AccentGreen"
                                     Style="{StaticResource TfAccentSwatch}"
                                     Checked="OnAccentChecked"
                                     Tag="Green">
                            <RadioButton.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3DDC97" Offset="0"/>
                                    <GradientStop Color="#0FA583" Offset="1"/>
                                </LinearGradientBrush>
                            </RadioButton.Background>
                        </RadioButton>
                        <RadioButton x:Name="AccentBlue"
                                     Style="{StaticResource TfAccentSwatch}"
                                     Checked="OnAccentChecked"
                                     Tag="Blue">
                            <RadioButton.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4FB6FF" Offset="0"/>
                                    <GradientStop Color="#2B6CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </RadioButton.Background>
                        </RadioButton>
                        <RadioButton x:Name="AccentViolet"
                                     Style="{StaticResource TfAccentSwatch}"
                                     Checked="OnAccentChecked"
                                     Tag="Violet">
                            <RadioButton.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#A78BFA" Offset="0"/>
                                    <GradientStop Color="#7C5CFC" Offset="1"/>
                                </LinearGradientBrush>
                            </RadioButton.Background>
                        </RadioButton>
                        <RadioButton x:Name="AccentAmber"
                                     Style="{StaticResource TfAccentSwatch}"
                                     Checked="OnAccentChecked"
                                     Tag="Amber">
                            <RadioButton.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FBD06A" Offset="0"/>
                                    <GradientStop Color="#F59E0B" Offset="1"/>
                                </LinearGradientBrush>
                            </RadioButton.Background>
                        </RadioButton>
                        <RadioButton x:Name="AccentRose"
                                     Style="{StaticResource TfAccentSwatch}"
                                     Checked="OnAccentChecked"
                                     Tag="Rose">
                            <RadioButton.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF9AA8" Offset="0"/>
                                    <GradientStop Color="#F0506E" Offset="1"/>
                                </LinearGradientBrush>
                            </RadioButton.Background>
                        </RadioButton>
                    </StackPanel>

                    <!-- Подсказка об ошибке -->
                    <TextBlock x:Name="ErrorText"
                               Margin="4,18,0,0"
                               FontSize="13"
                               Foreground="#FF9AA8"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                        <Button x:Name="CreateButton"
                                Style="{StaticResource TfPrimaryButton}"
                                Height="48"
                                Padding="26,0"
                                Content="Создать профиль"
                                IsDefault="True"
                                Click="OnCreateClick"/>
                        <Button Style="{StaticResource TfSecondaryButton}"
                                Height="48"
                                Margin="12,0,0,0"
                                Padding="22,0"
                                Content="Отмена"
                                IsCancel="True"
                                Click="OnCancelClick"/>
                    </StackPanel>

                    <Border Height="1" Margin="0,30,0,0" Background="{StaticResource TfLineGradient}" Opacity="0.7"/>

                    <TextBlock Text="Используется локальная регистрация — никаких паролей, подтверждений и подключения к интернету."
                               Margin="0,18,0,0"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TfFaintBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
