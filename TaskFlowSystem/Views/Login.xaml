<Window x:Class="TaskFlowSystem.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskFlow — Выбор профиля"
        Width="480"
        Height="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnWindowLoaded"
        KeyDown="OnWindowKeyDown"
        Opacity="0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TaskFlowSystem;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="12"
            Background="{StaticResource TfWindowGradient}"
            BorderBrush="#1E2B24"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка окна -->
            <Grid Grid.Row="0" Height="44" Margin="10,6,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Width="26" Height="26"
                            Background="{StaticResource TfAccentGradient}"
                            CornerRadius="8">
                        <TextBlock Text="TF"
                                   Foreground="#06251A"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TaskFlow"
                               Margin="10,0,0,0"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#DFF3E8"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource TfWindowCloseButton}"
                        Content="✕"
                        FontSize="12"
                        Click="OnCloseClick"
                        ToolTip="Закрыть"/>
            </Grid>

            <!-- Заголовок -->
            <StackPanel Grid.Row="1" Margin="44,22,44,0">
                <TextBlock Text="Кто работает?"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource TfTitleGradient}"/>
                <TextBlock x:Name="HeaderSubtitle"
                           Text="Выберите профиль, чтобы продолжить"
                           Margin="0,10,0,0"
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TfMutedBrush}"/>
            </StackPanel>

            <!-- Список профилей -->
            <ScrollViewer Grid.Row="2"
                          Margin="44,22,44,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ProfileList"/>
            </ScrollViewer>

            <!-- Действия -->
            <StackPanel Grid.Row="3" Margin="44,22,44,30">
                <TextBlock x:Name="ErrorText"
                           Margin="0,0,0,12"
                           FontSize="13"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Foreground="#FF9AA8"
                           AutomationProperties.LiveSetting="Assertive"
                           Visibility="Collapsed"/>
                <Button x:Name="CreateProfileButton"
                        Style="{StaticResource TfPrimaryButton}"
                        Height="50"
                        Margin="0,6,0,0"
                        AutomationProperties.Name="Новый профиль"
                        Click="OnCreateProfileClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" Margin="0,-2,10,0" FontSize="20"/>
                        <TextBlock Text="Новый профиль" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="FooterHint"
                           Margin="0,16,0,0"
                           FontSize="12"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TfFaintBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
